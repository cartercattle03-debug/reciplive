# On Vercel, set these in Project Settings > Environment Variables (never in the code).

# Postgres connection string from the RecipLive Supabase project
# (Connect > "Session pooler" URI).
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Login sessions - any long random string.
NEXTAUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Sign-up stays open only until the first ranch is made. Set to 1 to let more ranches sign up.
ALLOW_SIGNUP=""
